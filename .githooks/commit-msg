#!/bin/sh
# A-FIRST: keep the developmental evaluation (DE) record live.
#
# A commit that changes documentation, plugin code, course setup or course content must also stage a DE record
# (docs/developmental-evaluation/: DE_LOG.md, sprint reflections, advisory notes). The DE record is the data for the
# DE paper (advisory review, 6 Nov 2026), so it is written when the change happens, not reconstructed later.
#
# Typo-level changes: add a line "DE-skip: <reason>" to the commit message.
# Enable once per clone:  git config core.hooksPath .githooks

msgfile="$1"
if grep -qi '^DE-skip:' "$msgfile"; then
    exit 0
fi

staged=$(git diff --cached --name-only)
if printf '%s\n' "$staged" | grep -q '^docs/developmental-evaluation/'; then
    exit 0
fi
if printf '%s\n' "$staged" | grep -Eq '^(docs/|blocks/|local/|report/|course-setup/|courses/|evaluation/)'; then
    echo "DE check: this commit changes documentation or code but stages no developmental evaluation record." >&2
    echo "  Add an entry to docs/developmental-evaluation/DE_LOG.md (what we assumed, what happened, what we learned," >&2
    echo "  what we changed, evidence class) and stage it, or add 'DE-skip: <reason>' to the message for typo fixes." >&2
    exit 1
fi
exit 0
