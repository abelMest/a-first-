{{!
    @template block_afirst_assistant/report_form

    Form for reporting an answer for human review.

    Context variables required for this template:
    * id - Unique id prefix
    * reasons - List of {value, label}

    Example context (json):
    {
        "id": "afirst-msg-1-report",
        "reasons": [{"value": "inaccurate", "label": "Inaccurate"}, {"value": "other", "label": "Other"}]
    }
}}
<form class="block_afirst_assistant-report border rounded p-2 mt-1 small" data-region="report-form">
    <label for="{{id}}-reason" class="form-label mb-1">{{#str}} reportreason, block_afirst_assistant {{/str}}</label>
    <select id="{{id}}-reason" class="form-select form-select-sm mb-2" name="reason">
        {{#reasons}}<option value="{{value}}">{{label}}</option>{{/reasons}}
    </select>
    <label for="{{id}}-comment" class="form-label mb-1">{{#str}} reportcomment, block_afirst_assistant {{/str}}</label>
    <textarea id="{{id}}-comment" class="form-control form-control-sm mb-2" name="comment" rows="2" maxlength="2000"></textarea>
    <button type="submit" class="btn btn-secondary btn-sm">{{#str}} reportsend, block_afirst_assistant {{/str}}</button>
    <button type="button" class="btn btn-link btn-sm" data-action="cancel-report">{{#str}} cancel {{/str}}</button>
</form>
