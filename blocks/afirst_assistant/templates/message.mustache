{{!
    @template block_afirst_assistant/message

    One exchange: the learner's question and the assistant's answer, refusal or error.

    Context variables required for this template:
    * id - Unique id for this exchange
    * question - Learner question (escaped by Mustache)
    * answered - True for a grounded answer
    * refused - True when the assistant declined
    * error - True when the AI service failed
    * answerhtml - Answer as safe HTML with citation links (built from escaped text)
    * citations - Passages: n, sourcetitle, text, cited
    * logid - Log id for reporting
    * disclaimer - AI disclosure

    Example context (json):
    {
        "id": "afirst-msg-1",
        "question": "What are the dimensions of data quality?",
        "answered": true,
        "answerhtml": "Completeness, timeliness and accuracy are core dimensions. <sup><a href=\"#afirst-msg-1-c1\">[1]</a></sup>",
        "citations": [{"n": 1, "sourcetitle": "Module 1.2 Data Governance", "text": "Data quality dimensions include ...", "cited": true}],
        "logid": 42,
        "disclaimer": "This response is generated by AI and grounded in approved course content. Verify operational decisions with a qualified supervisor."
    }
}}
<div class="block_afirst_assistant-exchange mb-3" id="{{id}}" data-logid="{{logid}}">
    <div class="block_afirst_assistant-question ms-4 mb-2 p-2 rounded bg-primary text-white">{{question}}</div>
    {{#answered}}
    <div class="block_afirst_assistant-answer me-2 p-2 rounded border bg-white">
        <div class="mb-2">{{{answerhtml}}}</div>
        <div class="small">
            <div class="text-muted mb-1">{{#str}} sources, block_afirst_assistant {{/str}}</div>
            <ol class="list-unstyled mb-2">
                {{#citations}}
                <li id="{{id}}-c{{n}}">
                    <details>
                        <summary>[{{n}}] {{sourcetitle}}{{^cited}} <span class="text-muted">({{#str}} notcited, block_afirst_assistant {{/str}})</span>{{/cited}}</summary>
                        <blockquote class="block_afirst_assistant-passage border-start ps-2 my-1 text-muted">{{text}}</blockquote>
                    </details>
                </li>
                {{/citations}}
            </ol>
            <p class="fst-italic text-muted mb-1">{{disclaimer}}</p>
            <div class="d-flex align-items-center gap-1" data-region="rating">
                <span class="text-muted me-1">{{#str}} washelpful, block_afirst_assistant {{/str}}</span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-action="rate" data-rating="1"
                    aria-pressed="false">
                    <i class="icon fa fa-thumbs-up fa-fw m-0" aria-hidden="true"></i>
                    <span class="visually-hidden">{{#str}} helpful, block_afirst_assistant {{/str}}</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-action="rate" data-rating="-1"
                    aria-pressed="false">
                    <i class="icon fa fa-thumbs-down fa-fw m-0" aria-hidden="true"></i>
                    <span class="visually-hidden">{{#str}} nothelpful, block_afirst_assistant {{/str}}</span>
                </button>
            </div>
        </div>
    </div>
    {{/answered}}
    {{#refused}}
    <div class="alert alert-warning p-2 mb-0 small" role="status">{{#str}} refusal, block_afirst_assistant {{/str}}</div>
    {{/refused}}
    {{#error}}
    {{#ratelimited}}
    <div class="alert alert-info p-2 mb-0 small" role="alert">{{#str}} error:ratelimit, block_afirst_assistant {{/str}}</div>
    {{/ratelimited}}
    {{^ratelimited}}
    <div class="alert alert-danger p-2 mb-0 small" role="alert">{{#str}} error:service, block_afirst_assistant {{/str}}</div>
    {{/ratelimited}}
    {{/error}}
    {{^error}}
    <div data-region="report">{{> block_afirst_assistant/report_button }}</div>
    {{/error}}
</div>
