{{!
    @template block_afirst_assistant/launcher

    Floating "Ask the course" button and the assistant panel it opens, on every page of an enabled course.

    Context variables required for this template:
    * uniqid - Unique id prefix
    * modulename - "Module 2.2" when the learner is inside a module, or null
    * starters - Starter questions: [{question}]
    * hasstarters - Whether there are starters
    * nosources - True when no source is approved yet (only staff see the launcher then)
    * links - Staff links: [{url, label}]
    * haslinks - Whether there are links
    * disclaimer - AI disclosure

    Example context (json):
    {
        "uniqid": "afirstlauncher1",
        "modulename": "Module 2.2",
        "starters": [{"question": "What is exploratory data analysis?"}],
        "hasstarters": true,
        "nosources": false,
        "links": [{"url": "#", "label": "Review queue"}],
        "haslinks": true,
        "disclaimer": "This response is generated by AI and grounded in approved course content. Verify operational decisions with a qualified supervisor."
    }
}}
<div class="block_afirst_assistant-launcher" id="{{uniqid}}" data-region="afirst-assistant" data-mode="launcher">
    <button type="button" class="btn btn-primary block_afirst_assistant-fab" data-action="toggle-panel"
        aria-expanded="false" aria-controls="{{uniqid}}-panel">
        <i class="icon fa fa-comments fa-fw" aria-hidden="true"></i>
        <span>{{#str}} launcherbutton, block_afirst_assistant {{/str}}</span>
    </button>
    <section class="block_afirst_assistant-panel card" id="{{uniqid}}-panel" role="dialog" aria-modal="false"
        aria-labelledby="{{uniqid}}-title" hidden>
        <header class="block_afirst_assistant-panelhead card-header d-flex align-items-start gap-2">
            <div class="flex-grow-1">
                <h2 class="h5 mb-0" id="{{uniqid}}-title">{{#str}} pluginname, block_afirst_assistant {{/str}}</h2>
                {{#modulename}}
                <span class="badge bg-info-subtle text-info-emphasis mt-1">{{#str}} youarein, block_afirst_assistant, {{modulename}} {{/str}}</span>
                {{/modulename}}
            </div>
            <button type="button" class="btn btn-sm btn-link p-1" data-action="new-conversation"
                title="{{#str}} newconversation, block_afirst_assistant {{/str}}">
                <i class="icon fa fa-rotate-left fa-fw m-0" aria-hidden="true"></i>
                <span class="visually-hidden">{{#str}} newconversation, block_afirst_assistant {{/str}}</span>
            </button>
            <button type="button" class="btn btn-sm btn-link p-1" data-action="close-panel">
                <i class="icon fa fa-xmark fa-fw m-0" aria-hidden="true"></i>
                <span class="visually-hidden">{{#str}} closepanel, block_afirst_assistant {{/str}}</span>
            </button>
        </header>
        <div class="block_afirst_assistant-panelbody card-body" data-region="panelbody">
            <p class="small text-muted mb-2">{{#str}} intro, block_afirst_assistant {{/str}}</p>
            {{#nosources}}
            <div class="alert alert-warning small p-2">{{#str}} nosources, block_afirst_assistant {{/str}}</div>
            {{/nosources}}
            <div class="block_afirst_assistant-conversation" data-region="conversation" role="log" aria-live="polite"
                aria-label="{{#str}} conversation, block_afirst_assistant {{/str}}"></div>
            {{#hasstarters}}
            <div class="block_afirst_assistant-starters mb-2" data-region="starters">
                <div class="small text-muted mb-1">{{#str}} tryasking, block_afirst_assistant {{/str}}</div>
                {{#starters}}
                <button type="button" class="btn btn-outline-secondary btn-sm mb-1 text-start" data-action="starter">{{question}}</button>
                {{/starters}}
            </div>
            {{/hasstarters}}
            <div class="small text-muted" data-region="progress" role="status" aria-live="polite"></div>
            <div data-region="policy"></div>
        </div>
        <div class="card-footer">
            <form data-region="ask-form" class="block_afirst_assistant-form">
                <label for="{{uniqid}}-question" class="visually-hidden">{{#str}} question, block_afirst_assistant {{/str}}</label>
                <div class="d-flex gap-2 align-items-end">
                    <textarea id="{{uniqid}}-question" class="form-control" rows="2" maxlength="1000" data-region="question"
                        placeholder="{{#str}} questionplaceholder, block_afirst_assistant {{/str}}" required></textarea>
                    <button type="submit" class="btn btn-primary" data-action="ask">{{#str}} ask, block_afirst_assistant {{/str}}</button>
                </div>
                <p class="small text-muted mb-0 mt-1">{{disclaimer}}</p>
            </form>
            {{#haslinks}}
            <div class="small mt-1">
                {{#links}}<a href="{{url}}" class="me-3">{{label}}</a>{{/links}}
            </div>
            {{/haslinks}}
        </div>
    </section>
</div>
