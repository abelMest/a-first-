{{!
    @template block_afirst_assistant/assistant

    Shell of the course assistant: conversation area and question form.

    Context variables required for this template:
    * uniqid - Unique id prefix
    * disclaimer - AI disclosure shown before the first question

    Example context (json):
    {
        "uniqid": "afirst123",
        "disclaimer": "This response is generated by AI and grounded in approved course content. Verify operational decisions with a qualified supervisor."
    }
}}
<div class="block_afirst_assistant-root" id="{{uniqid}}" data-region="afirst-assistant" data-mode="block">
    <p class="small text-muted mb-2">{{#str}} intro, block_afirst_assistant {{/str}}</p>
    <div class="block_afirst_assistant-conversation mb-2" data-region="conversation"
        role="log" aria-live="polite" aria-label="{{#str}} conversation, block_afirst_assistant {{/str}}">
    </div>
    <div class="small text-muted mb-2" data-region="progress" role="status" aria-live="polite"></div>
    <div data-region="policy"></div>
    <form data-region="ask-form" class="block_afirst_assistant-form">
        <label for="{{uniqid}}-question" class="visually-hidden">{{#str}} question, block_afirst_assistant {{/str}}</label>
        <textarea id="{{uniqid}}-question" class="form-control mb-2" rows="2" maxlength="1000"
            data-region="question" placeholder="{{#str}} questionplaceholder, block_afirst_assistant {{/str}}" required></textarea>
        <div class="d-flex align-items-center justify-content-between">
            <span class="small text-muted pe-2">{{disclaimer}}</span>
            <button type="submit" class="btn btn-primary btn-sm flex-shrink-0" data-action="ask">
                {{#str}} ask, block_afirst_assistant {{/str}}
            </button>
        </div>
    </form>
</div>
