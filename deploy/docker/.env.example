# Copy to .env (ignored by git). Passwords do NOT go here: they live in secrets/*.txt.

# Address learners use. Must match how the proxy is reached.
MOODLE_WWWROOT=http://localhost:8720
# Set to 1 when TLS is terminated by the proxy (AFIRST_SITE_ADDRESS is a domain, or an external load balancer).
MOODLE_SSLPROXY=0
# Caddy site address: ":80" for plain HTTP, or a domain name for automatic HTTPS.
AFIRST_SITE_ADDRESS=:80
AFIRST_HTTP_PORT=8720
AFIRST_HTTPS_PORT=8743

MOODLE_SITE_FULLNAME=Africa CDC A-FIRST
MOODLE_SITE_SHORTNAME=afirst
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=admin@example.invalid

# Image and pinned Moodle release.
AFIRST_IMAGE=afirst/moodle:0.3.0
MOODLE_REF=v5.0.11

# Mail. Leave MOODLE_NOEMAIL=1 for test stacks so no learner is ever e-mailed by accident.
MOODLE_NOEMAIL=1
# MOODLE_SMTP_HOSTS=smtp.example.org:587
# MOODLE_SMTP_SECURE=tls
# MOODLE_SMTP_USER=
# MOODLE_SMTP_PASS_FILE=/run/secrets/smtp_password
